@app.route("/admin/pandit/<int:pid>/account", methods=["GET", "POST"])
@admin_required
def admin_pandit_account(pid):
    p = db().execute("SELECT * FROM pandits WHERE id=?", (pid,)).fetchone()
    if not p: abort(404)
    account = db().execute("SELECT username FROM pandit_accounts WHERE pandit_id=?", (pid,)).fetchone()
