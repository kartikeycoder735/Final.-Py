@app.route("/login", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        name = request.form.get("name", "").strip()
        phone = request.form.get("phone", "").strip()
        if not name or not phone.isdigit() or len(phone) != 10:
            abort(400, "Sahi naam aur 10 digit mobile number bharein.")
        c = db()
        c.execute("INSERT OR IGNORE INTO users(name,phone) VALUES(?,?)", (name, phone))
        c.commit()
        user = c.execute("SELECT id FROM users WHERE phone=?", (phone,)).fetchone()
        session.clear()
        session["uid"] = user["id"]
        nxt = request.form.get("next", "/")
        if not nxt.startswith("/") or nxt.startswith("//"): nxt = "/"
        return redirect(nxt)
    nxt = request.args.get("next", "/")
    return page("""
    <form class="card" method="post"><h1>Customer Login</h1>
    <input type="hidden" name="next" value="{{ nxt }}">
    <label>Name</label><input name="name" placeholder="Apna naam" required>
    <label>Mobile Number</label><input name="phone" maxlength="10" inputmode="numeric" placeholder="10 digit number" required>
    <button class="btn">Login</button><p class="mute">Demo login hai; OTP verification abhi nahi hai.</p></form>
    """, nxt=nxt)

