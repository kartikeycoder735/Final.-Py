      {% if b.status in ['pending','accepted'] %}
      <form method="post" action="/pandit/booking/{{ b.id }}/status">
        <button class="btn" name="status" value="accepted">Accept</button>
        <button class="btn danger" name="status" value="rejected">Reject</button>
        {% if b.status == 'accepted' %}<button class="btn btn2" name="status" value="completed">Completed</button>{% endif %}
      </form>
      {% endif %}
    </div>
    {% else %}<div class="card">Abhi koi appointment nahi hai.</div>{% endfor %}
    """, p=p, bookings=bookings)

