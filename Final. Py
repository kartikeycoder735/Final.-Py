        db().execute("""INSERT INTO pandit_accounts(pandit_id,username,password_hash)
        VALUES(?,?,?) ON CONFLICT(pandit_id) DO UPDATE SET
        username=excluded.username,password_hash=excluded.password_hash""",
        (pid, username, hash_pandit_password(password)))
        db().commit()
        flash(f"Pandit login set ho gaya. Username: {username}")
        return redirect("/admin")
