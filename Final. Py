def get_slots(pid):
    today = datetime.date.today()
    taken = {r["slot"] for r in db().execute(
        "SELECT slot FROM bookings WHERE pandit_id=? AND status IN ('pending','accepted')",
        (pid,)
    )}
    slots = []
    for i in range(1, 31):
        day = today + datetime.timedelta(days=i)
        for t in TIMES:
            s = f"{day.isoformat()} {t}"
            if s not in taken:
                slots.append(s)
    return slots

