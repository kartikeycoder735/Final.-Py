def hash_pandit_password(password):
    salt = secrets.token_hex(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("ascii"), 200000).hex()
    return salt + "$" + digest

def verify_pandit_password(password, stored):
    try:
        salt, expected = stored.split("$", 1)
        actual = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("ascii"), 200000).hex()
        return hmac.compare_digest(actual, expected)
    except (ValueError, TypeError):
        return False

class PGConn:
    """SQLite jaisa interface, Postgres ke upar (taaki baaki code na badalna pade)."""
    def __init__(self):
        self.conn = psycopg2.connect(DATABASE_URL)
    @staticmethod
    def fix(sql):
        sql = sql.replace("?", "%s").replace(" LIKE ", " ILIKE ")
        sql = sql.replace("SELECT last_insert_rowid()", "SELECT lastval()")
        if "INSERT OR IGNORE" in sql:
            sql = sql.replace("INSERT OR IGNORE", "INSERT").rstrip() + " ON CONFLICT DO NOTHING"
        return sql
    def execute(self, sql, params=()):
        cur = self.conn.cursor(cursor_factory=psycopg2.extras.DictCursor)
        cur.execute(self.fix(sql), params)
        return cur
    def executemany(self, sql, seq):
        cur = self.conn.cursor()
        cur.executemany(self.fix(sql), seq)
        return cur
    def commit(self):
        self.conn.commit()
    def close(self):
        self.conn.close()

def db():
    if "db" not in g:
        if DATABASE_URL:
            g.db = PGConn()
        else:
            g.db = sqlite3.connect(DB)
            g.db.row_factory = sqlite3.Row
            g.db.execute("PRAGMA foreign_keys=ON")
    return g.db

@app.teardown_appcontext
def close_db(error):
    conn = g.pop("db", None)
    if conn:
        conn.close()

SCHEMA = """
    CREATE TABLE IF NOT EXISTS users(
        id INTEGER PRIMARY KEY,
        name TEXT NOT NULL,
        phone TEXT UNIQUE NOT NULL
    );
    CREATE TABLE IF NOT EXISTS pandits(
        id INTEGER PRIMARY KEY,
        name TEXT,
        city TEXT,
        languages TEXT,
        specialty TEXT,
        experience INTEGER,
        fees INTEGER,
        rating REAL,
        about TEXT
    );
    CREATE TABLE IF NOT EXISTS pandit_accounts(
        pandit_id INTEGER PRIMARY KEY,
        username TEXT UNIQUE NOT NULL,
        password_hash TEXT NOT NULL,
        FOREIGN KEY(pandit_id) REFERENCES pandits(id) ON DELETE CASCADE
    );
    CREATE TABLE IF NOT EXISTS bookings(
        id INTEGER PRIMARY KEY,
        user_id INTEGER,
        pandit_id INTEGER,
        slot TEXT,
        mode TEXT,
        amount INTEGER,
        status TEXT DEFAULT 'pending',
        created_at TEXT,
        FOREIGN KEY(user_id) REFERENCES users(id),
        FOREIGN KEY(pandit_id) REFERENCES pandits(id)
    );
"""

def init_db():
    if DATABASE_URL:
        c = PGConn()
        ddl = SCHEMA.replace("REAL", "DOUBLE PRECISION")
        ddl = re.sub(r"(?m)^(\s+)id INTEGER PRIMARY KEY", r"\1id SERIAL PRIMARY KEY", ddl)
        c.conn.cursor().execute(ddl)
    else:
        c = sqlite3.connect(DB)
        c.execute("PRAGMA foreign_keys=ON")
        c.executescript(SCHEMA)
    if not c.execute("SELECT id FROM pandits LIMIT 1").fetchone():
        c.executemany("""
        INSERT INTO pandits
        (name,city,languages,specialty,experience,fees,rating,about)
        VALUES(?,?,?,?,?,?,?,?)
        """, PANDITS)
    if DATABASE_URL:
        c.execute("ALTER TABLE bookings ADD COLUMN IF NOT EXISTS room TEXT")
    else:
        cols = [r[1] for r in c.execute("PRAGMA table_info(bookings)")]
        if "room" not in cols:
            c.execute("ALTER TABLE bookings ADD COLUMN room TEXT")
    c.commit()
    c.close()

