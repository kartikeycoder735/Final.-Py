@app.route("/pandit/login", methods=["GET", "POST"])
def pandit_login():
    if request.method == "POST":
        username = request.form.get("username", "").strip()
        password = request.form.get("password", "")
        row = db().execute("""SELECT a.pandit_id,a.password_hash,p.name
        FROM pandit_accounts a JOIN pandits p ON p.id=a.pandit_id
        WHERE a.username=?""", (username,)).fetchone()
        if row and verify_pandit_password(password, row["password_hash"]):
            session.clear()
            session["pandit_id"] = row["pandit_id"]
            return redirect(url_for("pandit_dashboard"))
