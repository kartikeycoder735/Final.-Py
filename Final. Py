    if not p:
        session.pop("pandit_id", None)
        return redirect(url_for("pandit_login"))
    bookings = db().execute("""SELECT b.*,u.name AS customer
    FROM bookings b LEFT JOIN users u ON u.id=b.user_id
    WHERE b.pandit_id=? ORDER BY b.slot ASC""", (pid,)).fetchall()
    return page("""
    <h1>Pandit Dashboard</h1>
