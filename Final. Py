@app.route("/book/<int:pid>", methods=["POST"])
def book(pid):
    r = login_required()
    if r: return r
    p = db().execute("SELECT * FROM pandits WHERE id=?", (pid,)).fetchone()
    if not p: abort(404)
    slot, mode = request.form.get("slot", ""), request.form.get("mode", "")
    if slot not in get_slots(pid): abort(400, "Slot available nahi hai. Doosra slot chunein.")
    if mode not in ("audio", "video", "in_person"): abort(400)
    c = db()
    c.execute("""INSERT INTO bookings(user_id,pandit_id,slot,mode,amount,status,created_at,room)
    VALUES(?,?,?,?,?,'pending',?,?)""",
    (session["uid"], pid, slot, mode, p["fees"], datetime.datetime.now().isoformat(), secrets.token_urlsafe(9)))
    c.commit()
    bid = c.execute("SELECT last_insert_rowid()").fetchone()[0]
    return redirect(url_for("booking", bid=bid))

