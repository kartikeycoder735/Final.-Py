@app.route("/admin/pandit/add", methods=["GET", "POST"])
@admin_required
def admin_add_pandit():
    if request.method == "POST":
        try:
            name = request.form.get("name", "").strip()
            city = request.form.get("city", "").strip()
            languages = request.form.get("languages", "").strip()
            specialty = request.form.get("specialty", "").strip()
            experience = int(request.form.get("experience", "0"))
            fees = int(request.form.get("fees", "0"))
            rating = float(request.form.get("rating", "5"))
            about = request.form.get("about", "").strip()
            if not all([name, city, languages, specialty, about]) or experience < 0 or fees < 0 or not 0 <= rating <= 5:
                raise ValueError()
        except ValueError:
            flash("Sabhi details sahi bharein.")
            return redirect(url_for("admin_add_pandit"))
        db().execute("""INSERT INTO pandits(name,city,languages,specialty,experience,fees,rating,about)
        VALUES(?,?,?,?,?,?,?,?)""", (name,city,languages,specialty,experience,fees,rating,about))
        db().commit()
        flash("Naya Pandit add ho gaya.")
        return redirect("/admin")
    return pandit_form()

